      col('firstSeen', 'First seen', SCRIPT, { width: 110 }),
      col('lastSeen', 'Last seen', SCRIPT, { width: 110, help: 'Stops advancing when a posting leaves the board.' }),
      col('url', 'URL', SCRIPT, { width: 260 }),
